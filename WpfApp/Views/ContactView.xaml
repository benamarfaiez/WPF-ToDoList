<UserControl x:Class="WpfApp.Views.ContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Contacts" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,12"
                   Text="Sélectionne un contact : l'onglet Tâches réagira automatiquement."/>

        <ListBox ItemsSource="{Binding Contacts}"
                 SelectedItem="{Binding ContactSelectionne}"
                 DisplayMemberPath="NomComplet"/>
    </DockPanel>
</UserControl>
