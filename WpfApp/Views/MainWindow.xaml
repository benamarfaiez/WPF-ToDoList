<Window x:Class="WpfApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        xmlns:views="clr-namespace:WpfApp.Views"
        Title="Gestionnaire de Tâches" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">

    <!-- Mapping implicite ViewModel -> View : dès que Navigation.CurrentViewModel
         change de TYPE, WPF choisit automatiquement le bon DataTemplate ci-dessous. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ContactViewModel}">
            <views:ContactView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TacheViewModel}">
            <views:TacheView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#1B2A4A">
            <Button Content="Contacts" Command="{Binding AllerAuxContactsCommand}"
                    Padding="14,10" Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button Content="Tâches" Command="{Binding AllerAuxTachesCommand}"
                    Padding="14,10" Background="Transparent" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- Le shell ne sait pas CE QU'IL affiche, seulement QUOI (le ViewModel courant). -->
        <ContentControl Content="{Binding Navigation.CurrentViewModel}"/>
    </DockPanel>
</Window>
